# Legacy read-only infrastructure discovery. Not part of the self-hosted setup.
# Existing .env.tencent files can stay private; no migration is required.
# Use .env.deploy.example and deploy/tencent-access.md for ADP/runtime settings.
# Never copy discovery credentials to a server, image, or .env.deploy.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Required only for temporary credentials.
TENCENT_TOKEN=
TENCENT_REGION=ap-singapore

# Historical discovery budget; not a Tencent-enforced spending cap.
DEPLOY_MONTHLY_BUDGET=0
DEPLOY_BUDGET_CURRENCY=USD
