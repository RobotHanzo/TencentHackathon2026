# Runtime settings for your own Docker host; Tencent compute is not required.
# Copy to .env.deploy; never commit real values. On Linux: chmod 600 .env.deploy.
# Prefer a successfully published sha-<full-40-character-commit-SHA> tag.
# For arm64, choose a tag published by the multi-platform workflow; old tags may be amd64-only.
CLEARPORT_IMAGE=ghcr.io/robothanzo/tencenthackathon2026:main
CLEARPORT_PORT=3001
# true: skip login and enable demo persona switching, including in the Docker image.
DEMO_MODE=false
# Required when DEMO_MODE=false (at least 12 characters); optional for demos.
APP_ACCESS_PASSWORD=
APP_USER_ID=manager-sarah
# Print one line per web request to `docker compose logs instill`. Set false to silence.
ACCESS_LOG=true

# HTTPS overlay only: hostname without https://, a path, or a port.
CLEARPORT_DOMAIN=
CLEARPORT_TLS_EMAIL=
# compose.https.yaml forces true. Keep false for HTTP localhost/SSH tunnels.
# Set true manually when using your own HTTPS reverse proxy with base Compose.
APP_COOKIE_SECURE=false

# local: no external model requests; adp: Tencent ADP; openai: compatible API.
AI_PROVIDER=local
# Use the published application's API key, not a Tencent SecretKey or App ID.
# ADP chat needs no CAM credentials. See deploy/tencent-access.md.
ADP_APP_KEY=
ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat
# An ADP agent thinks and calls tools before it answers (often 10-20 s). The default wait is
# 40 s for ADP and 20 s for other providers; raise it only if Settings reports a timeout.
AI_TIMEOUT_MS=
# Provider calls allowed per hour across all visitors. A public demo can be clicked by anyone, so
# this protects the Tencent allowance; the local advisor answers once it is used up.
AI_CALLS_PER_HOUR=120

# Optional ADP-managed knowledge sync; separate from chat API credentials.
# API region is ADP's region, independent of your Docker host. Confirm support.
# Use a scoped runtime identity, not the old .env.tencent discovery credentials.
ADP_KNOWLEDGE_SYNC=false
ADP_APP_BIZ_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TOKEN=
TENCENT_REGION=ap-jakarta
# Publishes ALL app drafts. Enable only for a dedicated Instill ADP app.
ADP_AUTO_PUBLISH=false

# Optional original-file archive: existing PRIVATE COS bucket in Singapore.
# Uses scoped Tencent credentials above. Blank bucket disables archival.
COS_BUCKET=
COS_REGION=ap-singapore

# Used only with AI_PROVIDER=openai. All three are required for that provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
