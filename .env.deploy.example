# Copy to .env.deploy; never commit real values. On Linux: chmod 600 .env.deploy.
# Prefer a successfully published sha-<full-40-character-commit-SHA> tag.
CLEARPORT_IMAGE=ghcr.io/robothanzo/tencenthackathon2026:main
CLEARPORT_PORT=3001
APP_ACCESS_PASSWORD=
APP_USER_ID=manager-sarah

# HTTPS overlay only: hostname without https://, a path, or a port.
CLEARPORT_DOMAIN=
CLEARPORT_TLS_EMAIL=
# compose.tencent.yaml forces true. Keep false for HTTP localhost/SSH tunnels.
APP_COOKIE_SECURE=false

# local: no external model requests; adp: Tencent ADP; openai: compatible API.
AI_PROVIDER=local
# Use the published application's API key, not a Tencent SecretKey or App ID.
ADP_APP_KEY=
ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat

# Optional ADP-managed knowledge sync; separate from chat API credentials.
# API region is ADP's region, NOT the CVM host region. Confirm tenant support.
ADP_KNOWLEDGE_SYNC=false
ADP_APP_BIZ_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TOKEN=
TENCENT_REGION=ap-jakarta
# Publishes ALL app drafts. Enable only for a dedicated Clearport ADP app.
ADP_AUTO_PUBLISH=false

# Optional original-file archive: existing PRIVATE COS bucket in Singapore.
# Uses scoped Tencent credentials above. Blank bucket disables archival.
COS_BUCKET=
COS_REGION=ap-singapore

# Used only with AI_PROVIDER=openai. All three are required for that provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
