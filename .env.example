# Fictional Singapore demo. Demo mode skips login and enables persona switching.
DEMO_MODE=true
PORT=3001
# Keep local development private. Containers set HOST=0.0.0.0 internally.
HOST=127.0.0.1
DATA_PATH=data/clearport.db

# Choose local, adp, or openai. Keep credentials server-side.
AI_PROVIDER=local
# For Tencent ADP: publish the application and copy its application API key.
# The default API hostname does not guarantee Singapore-only processing.
# AI_PROVIDER=adp
# ADP_APP_KEY=
# ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat

# Optional ADP knowledge sync uses separate, scoped Tencent API credentials.
# The ADP API region is independent of your Docker host's location.
# ADP_KNOWLEDGE_SYNC=true
# ADP_APP_BIZ_ID=
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_TOKEN=
# TENCENT_REGION=ap-jakarta
# ADP_AUTO_PUBLISH=false
# Auto-publishing releases every draft in the ADP app; use a dedicated app.

# Optional archive of original uploads to a PRIVATE Singapore COS bucket.
# Uses scoped Tencent credentials above; blank COS_BUCKET disables archival.
# COS_BUCKET=
# COS_REGION=ap-singapore

# For an OpenAI-compatible provider, choose openai and set all three below.
# AI_PROVIDER=openai
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# For a non-demo, single-operator local deployment:
# NODE_ENV=production
# DEMO_MODE=false
# APP_ACCESS_PASSWORD=replace-with-at-least-12-characters
# APP_USER_ID=manager-sarah
# APP_COOKIE_SECURE=false
# Set true when serving through an HTTPS reverse proxy.
# HTTP Basic username: instill. Role switching is disabled outside demo mode.
# See DEPLOY.md for container deployment settings.
# Multi-user production SSO and access provisioning are out of scope.
