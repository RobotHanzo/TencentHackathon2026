# Local fictional Singapore demo. Never enable demo role switching in production.
DEMO_MODE=true
PORT=3001
# Keep local development private. Containers set HOST=0.0.0.0 internally.
HOST=127.0.0.1
DATA_PATH=data/clearport.db

# Optional OpenAI-compatible provider. Keep credentials server-side.
# Set all three to enable live grounded chat and supplementary AI review.
# Without them, Clearport uses labelled deterministic checks and local retrieval.
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# For a non-demo, single-operator local deployment:
# NODE_ENV=production
# DEMO_MODE=false
# APP_ACCESS_PASSWORD=replace-with-at-least-12-characters
# APP_USER_ID=manager-sarah
# HTTP Basic username: clearport. Role switching is disabled outside demo mode.
# See DEPLOY.md for container deployment settings.
# Multi-user production SSO and access provisioning are out of scope.
